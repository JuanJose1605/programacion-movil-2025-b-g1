// Try Prisma Accelerate: https://pris.ly/cli/accelerate-init

generator client {
  provider = "prisma-client-js"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum EstadoUsuario {
  activo
  inactivo
}

enum EstadoPedido {
  pendiente
  entregado
}



model Usuarios {
  id_usuario      String            @id 
  nombres         String
  apellidos       String?
  username        String         @unique
  password        String
  fecha_registro  DateTime       @default(now())

  pedidos         Pedidos[]      
}



model Productos {
  id_producto   Int           @id @default(autoincrement())
  nombre        String
  descripcion   String?
  precio        String
  stock         String   
  imagen_url    String?   
  estado        EstadoUsuario  @default(activo)

  detalles      PedidoDetalle[]
}

model Inventario {
  id_inventario Int      @id @default(autoincrement())
  id_producto   Int
  stock         Int       @default(0)

}

model Pedidos {
  id_pedido       Int           @id @default(autoincrement())
  id_usuario      String
  fecha_pedido    DateTime      @default(now())
  total           Decimal?
  direccion_envio String?
  estado          EstadoPedido  @default(pendiente)

  carrito         Json?         // 👈 aqui guardamos todo el contenido del carrito

  usuario         Usuarios?     @relation(fields: [id_usuario], references: [id_usuario])
}


model PedidoDetalle {
  id_detalle   Int       @id @default(autoincrement())
  id_pedido    Int
  id_producto  Int
  cantidad     Int
  subtotal     Decimal?

  producto     Productos @relation(fields: [id_producto], references: [id_producto])
}
